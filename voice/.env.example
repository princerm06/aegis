# AEGIS Voice V1 — Local Environment Configuration
# Copy this file to `voice/.env` (which is git-ignored) and insert your real key.
# NEVER commit a real ElevenLabs API key or expose it in NEXT_PUBLIC_* variables.

ELEVENLABS_API_KEY=replace_with_your_key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# Authoritative AEGIS FastAPI Simulation Backend (Read-Only Consumer)
AEGIS_BACKEND_URL=http://127.0.0.1:8000
AEGIS_SCENARIO_ID=demo

# Standalone Voice Service Bindings
VOICE_HOST=127.0.0.1
VOICE_PORT=8010
VOICE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8010,http://127.0.0.1:8010
